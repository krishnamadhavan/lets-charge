{
  "name": "lets-charge",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @letscharge/api --filter @letscharge/web run dev",
    "dev:api": "pnpm --filter @letscharge/api dev",
    "dev:web": "pnpm --filter @letscharge/web dev",
    "db:up": "docker compose -f deploy/compose.yml up -d",
    "db:down": "docker compose -f deploy/compose.yml down"
  }
}
